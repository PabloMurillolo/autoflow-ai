{
  "name": "autoflow-ai",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run src && node --test server/*.test.mjs",
    "check": "npm test && npm run build && npm run build:server",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:server": "tsc -b && vite build --mode server",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "owner:setup": "node --env-file=.env server/manage.mjs owner",
    "data:prune": "node --env-file=.env server/manage.mjs prune",
    "data:backup": "node --env-file=.env server/manage.mjs backup",
    "eval:ai": "node --env-file-if-exists=.env server/evaluate.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "prettier": "^3.9.8",
    "typescript": "~5.9.3",
    "vite": "^7.2.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
