# The GitHub Pages demo requires no environment variables.
# For the private server, copy this to .env (ignored by git).
APP_ORIGIN=http://127.0.0.1:3000
HOST=127.0.0.1
PORT=3000
DATABASE_PATH=./data/autoflow.sqlite
DEFAULT_SHOP_SLUG=miami-auto-care
LEAD_RETENTION_DAYS=90
# One-time provisioning: set your own credentials, run npm run owner:setup,
# then remove OWNER_PASSWORD. No built-in/default password exists.
SHOP_SLUG=miami-auto-care
SHOP_NAME="Miami Auto Care"
OWNER_EMAIL=
OWNER_PASSWORD=
# For data:backup, choose a new protected file outside dist and dist-server.
BACKUP_PATH=
# Future SERVER-ONLY integrations (not connected in v0.2):
OPENAI_API_KEY=
HF_API_KEY_ID=
HF_API_KEY_SECRET=
CALENDAR_CLIENT_ID=
CALENDAR_CLIENT_SECRET=
SMS_API_KEY=
CRM_API_KEY=
# Never prefix secrets with VITE_: those are exposed in browser bundles.
